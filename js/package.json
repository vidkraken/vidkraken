{
  "name": "vidkraken",
  "version": "0.1.0",
  "description": "Official Vid Kraken SDK and CLI: download YouTube videos and audio (MP4, MP3, M4A) through the Vid Kraken API.",
  "keywords": [
    "youtube",
    "youtube-download",
    "youtube-api",
    "mp4",
    "mp3",
    "yt-dlp-alternative",
    "vidkraken"
  ],
  "homepage": "https://vidkraken.com",
  "bugs": {
    "email": "hello@vidkraken.com",
    "url": "https://github.com/vidkraken/vidkraken/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vidkraken/vidkraken.git",
    "directory": "js"
  },
  "license": "MIT",
  "author": "Vid Kraken <hello@vidkraken.com>",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "vidkraken": "dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsup",
    "typecheck": "tsc --noEmit",
    "test": "node --test test/*.test.mjs",
    "prepublishOnly": "npm run typecheck && npm run build && npm test"
  },
  "devDependencies": {
    "@types/node": "^18.19.130",
    "tsup": "^8.5.1",
    "typescript": "~5.9.3"
  }
}
